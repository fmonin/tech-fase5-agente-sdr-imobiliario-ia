# =============================================================================
# MODELO do .env — copie para ".env" e preencha. O .env NUNCA vai para o Git.
# Aqui ficam SOMENTE chaves e tokens. Todas as outras configurações estão em
# config/settings.toml (versionado) e config/settings.local.toml (desta máquina).
# Modelo para quem clonar o projeto: .env.example
# =============================================================================

# Azure OpenAI (Portal do Azure > recurso > "Chaves e Ponto de Extremidade")
AZURE_OPENAI_API_KEY=

# Azure Speech (opcional — Voice AI)
AZURE_SPEECH_KEY=

# Telegram (token do @BotFather)
TELEGRAM_BOT_TOKEN=
